# Gmail SMTP credentials. Never commit a real app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME=POULTRIVA
SMTP_ADMIN_EMAIL=admin@example.com

# Google Apps Script Web App /exec URL that appends leads to the Sheet.
LEAD_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec
